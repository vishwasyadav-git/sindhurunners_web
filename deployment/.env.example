# =============================================================================
# .env.example — Environment variable template for Sindhu Runners Event Pay
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env (with real secrets) to Git.
# .env is already in .gitignore — verify this before pushing.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:mysql://mysql-db:3306/sindhu_event_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=sindhu_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com/app/keys
# For local testing: use Test mode keys (rzp_test_xxx)
# For production:   use Live mode keys (rzp_live_xxx)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_KEY_SECRET

# Webhook secret is set in: Razorpay Dashboard → Webhooks → [your webhook] → Secret
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_WEBHOOK_SECRET

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# The name of your private S3 bucket for Aadhaar documents
AWS_S3_BUCKET=sindhu-runners-aadhaar-documents-dev

# PRODUCTION: Leave these blank and use an IAM role on EC2/ECS instead.
# LOCAL/DEV:  Set these to your IAM user credentials with S3 write permissions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, use your exact domain: https://www.sindhurunners.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
